<?xml version="1.0" encoding="utf-8"?>
<!--
  A single-day band in the preview. White so `backgroundTint` can colour it at the use site — one
  drawable for every event colour, rather than a file per swatch. Only single-day chips are rounded,
  the same rule the widget follows: a rounded run notches at every internal seam.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="3dp" />
</shape>
