    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shadow under the page. -->
    <path
        android:fillColor="#403730A3"
        android:pathData="M37,37h36a7,7 0 0,1 7,7v28l-10,10h-33a7,7 0 0,1 -7,-7v-31a7,7 0 0,1 7,-7z" />

    <!-- The page, its bottom-right corner cut where it curls. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M37,34h34a7,7 0 0,1 7,7v28l-11,11h-30a7,7 0 0,1 -7,-7v-32a7,7 0 0,1 7,-7z" />

    <!-- Header band. -->
    <path
        android:fillColor="#FFE0E7FF"
        android:pathData="M37,34h34a7,7 0 0,1 7,7v5h-48v-5a7,7 0 0,1 7,-7z" />

    <!-- The curl. -->
    <path
        android:fillColor="#FFC7D2FE"
        android:pathData="M78,69l-11,11v-7a4,4 0 0,1 4,-4z" />

    <!-- Binder rings. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FF6366F1"
        android:strokeWidth="1.6"
        android:pathData="M42.5,28a2.5,2.5 0 0,1 2.5,2.5v8a2.5,2.5 0 0,1 -5,0v-8a2.5,2.5 0 0,1 2.5,-2.5z" />
