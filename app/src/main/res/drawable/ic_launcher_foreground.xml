        android:strokeColor="#FF5B5BD6"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38.5,56.5C38.5,53.2 41.2,51 44.5,51C47.8,51 50.5,53.2 50.5,56.3C50.5,59.3 48.6,61.2 46.2,63.4L38.5,72L50.8,72" />

