<?xml version="1.0" encoding="utf-8"?>
<!--
  Styles for layout/month_widget_preview.xml, layout/today_widget_preview.xml, and
  layout/day_glance_widget_preview.xml.

  The preview is a still of the widget written in plain containers, because the widget itself is
  Glance and Glance 1.1.1 has no way to render a preview (`providePreview` and `setWidgetPreviews`
  arrived after it). Forty-two day cells written out longhand would be six attributes each; these
  carry the repetition so the layout stays readable enough to keep in step with MonthWidget.kt by eye.

  The dots are AAPT's implicit inheritance — `WidgetPreview.Day` extends `WidgetPreview` — so the
  base below has to exist even though it sets only the one thing every child shares.
-->
<resources>

    <style name="WidgetPreview">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="WidgetPreview.Day">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/widget_preview_text</item>
    </style>

    <!-- A day spilling in from the neighbouring month: visible, receding. -->
    <style name="WidgetPreview.Day.Outside">
        <item name="android:textColor">@color/widget_preview_muted</item>
    </style>

    <!--
      Today keeps its column's weight on the wrapper and puts the ring on the number inside it, the
      same two-box arrangement DayNumber uses in the widget: a ring stretched to the full width of a
      cell is an ellipse, not the circle the Month page draws.
    -->
    <style name="WidgetPreview.DayCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="WidgetPreview.Today">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/widget_month_today</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/widget_month_on_pill</item>
    </style>

    <style name="WidgetPreview.Weekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_month_muted</item>
    </style>

    <style name="WidgetPreview.Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">13dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">10sp</item>
        <!-- The two ends of onChipColor's WCAG crossover, picked per band by hand here because a
             still has no luminance to test. -->
        <item name="android:textColor">#FFFAFAFA</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetPreview.Chip.OnDark">
        <item name="android:textColor">#FFFAFAFA</item>
    </style>

    <style name="WidgetPreview.Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/widget_preview_rule</item>
    </style>

    <style name="WidgetPreview.Chevron">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="WidgetPreview.Column">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="WidgetPreview.ColumnRule">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_month_column_rule</item>
    </style>

    <style name="WidgetPreview.DotCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">13dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="WidgetPreview.Dot">
        <item name="android:layout_width">5dp</item>
        <item name="android:layout_height">5dp</item>
        <item name="android:layout_marginStart">1.5dp</item>
        <item name="android:layout_marginEnd">1.5dp</item>
        <item name="android:background">@drawable/widget_preview_dot</item>
    </style>

    <!-- layout/today_widget_preview.xml: Agenda rows (colour bar, start/end times, title). -->
    <style name="WidgetPreview.TodayRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="WidgetPreview.TodayBar">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="WidgetPreview.TodayTimes">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetPreview.TodayStart">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#1A1C18</item>
    </style>

    <style name="WidgetPreview.TodayEnd">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#43483F</item>
    </style>

    <style name="WidgetPreview.TodayTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#1A1C18</item>
    </style>

    <!-- layout/day_glance_widget_preview.xml: 24 hour cells across two half-day rows. -->
    <style name="WidgetPreview.GlanceCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">#DFE6D8</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingTop">2dp</item>
    </style>

    <style name="WidgetPreview.GlanceCell.Current">
        <item name="android:background">#C5E8B8</item>
    </style>

    <style name="WidgetPreview.GlanceCell.Last">
        <item name="android:layout_marginEnd">0dp</item>
    </style>

    <style name="WidgetPreview.GlanceHour">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#43483F</item>
    </style>

    <style name="WidgetPreview.GlanceHour.Current">
        <item name="android:textColor">#1A1C18</item>
    </style>

</resources>
