    <!-- Permission gate -->
    <string name="perm_title">Calendar access</string>
    <string name="perm_body">Schedule reads the calendars already synced to this device so it can show your day and tell you when you\'re free. Events you add here sync back through your Google account. Nothing is sent anywhere else.</string>
    <string name="perm_declined">Access was declined. Turn on Calendar in system settings to continue.</string>
    <string name="perm_open_settings">Open settings</string>
    <string name="perm_grant">Grant access</string>
    <string name="perm_autostart_title">On a Xiaomi phone?</string>
    <string name="perm_autostart_body">Turn on Autostart for Google Calendar as well. It uploads the events you add here, and without Autostart they can take minutes to reach Google. In the list, it\'s the Calendar with the blue 31 icon.</string>
    <string name="autostart_tip_body">On Xiaomi, Redmi and POCO phones, turn on Autostart for Google Calendar. Google Calendar does the uploading, and without Autostart your changes can wait for minutes until it happens to run. In the list, it\'s the Calendar with the blue 31 icon, not Xiaomi\'s own Calendar.</string>
    <string name="autostart_open_settings">Open Autostart settings</string>

